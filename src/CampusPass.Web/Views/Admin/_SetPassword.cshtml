@model string
<form class="card" method="post" action="/Admin/SetPassword" asp-antiforgery="true">
    <div class="card-title">Set a password</div>
    <input type="hidden" name="tab" value="@Model" />
    <div class="field"><label for="sp-user">Username or reg no</label><input class="input mono" id="sp-user" name="username" required placeholder="@(Model == "students" ? "EB1/0001/23" : "STAFF 1")" /></div>
    <div class="field"><label for="sp-pass">New password</label><input class="input" id="sp-pass" name="password" type="text" minlength="8" required autocomplete="off" /></div>
    <label class="check mb-2"><input type="checkbox" name="mustChange" value="true" checked /> Must change it at next sign-in</label>
    <input type="hidden" name="mustChange" value="false" />
    <button class="btn btn-outline btn-block"><partial name="_Icon" model="@("key")" />Set password</button>
    <p class="hint mb-0">Use for training days or when someone is locked out. Untick the box to keep the password as given.</p>
</form>
