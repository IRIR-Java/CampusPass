@{ ViewData["Title"] = "Choose your password"; }
<div class="auth">
    <div class="auth-box">
        <span class="brand-mark"><partial name="_Icon" model="@("key")" /></span>
        <div class="auth-title">Choose your own password</div>
        <p class="muted">For your security, replace the one-time password with one only you know.</p>
        <form method="post" class="card" asp-action="ChangePassword">
            @if (ViewData["Error"] is string err) { <div class="flash flash-error"><partial name="_Icon" model="@("alert")" /><span>@err</span></div> }
            <div class="field"><label for="current">Current (one-time) password</label><div class="pw"><input class="input" type="password" id="current" name="current" autocomplete="current-password" required autofocus /><button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><span class="i-on"><partial name="_Icon" model="@("eye")" /></span><span class="i-off"><partial name="_Icon" model="@("eye-off")" /></span></button></div></div>
            <div class="field"><label for="next">New password</label><div class="pw"><input class="input" type="password" id="next" name="next" minlength="8" autocomplete="new-password" required /><button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><span class="i-on"><partial name="_Icon" model="@("eye")" /></span><span class="i-off"><partial name="_Icon" model="@("eye-off")" /></span></button></div><div class="hint">At least 8 characters. Don't include your reg number or username.</div></div>
            <div class="field"><label for="confirm">New password again</label><div class="pw"><input class="input" type="password" id="confirm" name="confirm" minlength="8" autocomplete="new-password" required /><button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><span class="i-on"><partial name="_Icon" model="@("eye")" /></span><span class="i-off"><partial name="_Icon" model="@("eye-off")" /></span></button></div></div>
            <button class="btn btn-primary btn-lg btn-block">Save password</button>
        </form>
        <form method="post" action="/Account/Logout" asp-antiforgery="true" class="center mt-2"><button class="link-btn">Sign out</button></form>
    </div>
</div>
