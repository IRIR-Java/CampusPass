@{
    ViewData["Title"] = "Welcome";
    var inst = ViewData["Institution"] as string;
}
@section Head { <link rel="preload" as="image" href="/img/campus-800.jpg" imagesrcset="/img/campus-800.jpg 800w, /img/campus-1600.jpg 1600w" imagesizes="(min-width: 980px) 58vw, 100vw" /> }
<div class="welcome">
    <div class="welcome-photo">
        <img src="/img/campus-800.jpg" srcset="/img/campus-800.jpg 800w, /img/campus-1600.jpg 1600w" sizes="(min-width: 980px) 58vw, 100vw"
             alt="Aerial view of the @inst main gate and campus buildings" />
        <div class="welcome-top">
            <span class="brand-mark"><partial name="_Icon" model="@("ticket")" /></span>
            <b>@inst</b>
        </div>
        <div class="welcome-headline">
            <h1>No more long lines at the gate, Finance or the Registrar.</h1>
            <p>Check your fees, get your gatepass and join any office's queue from your phone.</p>
            <div class="feat-glass">
                <div><partial name="_Icon" model="@("digital")" /><b>Digital Queue</b><span>No more long physical lines.</span></div>
                <div><partial name="_Icon" model="@("calendar")" /><b>Smart Batching</b><span>A time window, not just a number.</span></div>
                <div><partial name="_Icon" model="@("shield")" /><b>Organized Services</b><span>Right service. Right office.</span></div>
                <div><partial name="_Icon" model="@("qr")" /><b>QR Gatepass</b><span>Checked live at the gate.</span></div>
            </div>
        </div>
    </div>

    <section class="welcome-sheet">
        <div class="brand-name">Campus<em>Pass</em></div>
        <p class="tag">Join the queue remotely, wait less, get things done.</p>

        <ul class="points">
            <li><span class="tile-ic t-green"><partial name="_Icon" model="@("qr")" /></span><div><b>Fees cleared? Your gatepass is ready</b><span>No stamping, no queue. Show the QR at the gate.</span></div></li>
            <li><span class="tile-ic t-blue"><partial name="_Icon" model="@("calendar")" /></span><div><b>Get a time window, not a line</b><span>Come when your batch is called.</span></div></li>
            <li><span class="tile-ic t-amber"><partial name="_Icon" model="@("bell")" /></span><div><b>We tell you when it's your turn</b><span>Wait anywhere on campus.</span></div></li>
        </ul>

        <div class="welcome-cta">
            <a class="btn btn-primary btn-lg btn-block" href="/Account/Login?first=true">Get Started <partial name="_Icon" model="@("arrow")" /></a>
            <a class="btn btn-outline btn-lg btn-block" href="/Account/Login">I already have an account</a>
        </div>
        <div class="welcome-foot">Staff and administrators sign in with the same button.</div>
    </section>
</div>
